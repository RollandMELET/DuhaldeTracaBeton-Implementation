            "duration": 300000,
            "warningAt": 240000,
            "timeoutAction": "logout"
          }
        },
        "components": {
          "showHeader": true,
          "showFooter": true,
          "showProgressBar": false,
          "showBackButton": true,
          "showHelpButton": true,
          "showLogoutButton": true
        },
        "responsive": {
          "orientation": "landscape",
          "targetResolution": "1280x800",
          "minTouchTarget": 64,
          "minFontSize": 20
        },
        "accessibility": {
          "highContrast": true,
          "largeFonts": true,
          "hapticFeedback": true,
          "gestureAlternatives": true
        }
      },
      
      "businessRules": {
        "rules": [
          {
            "id": "supervisor_authentication_required",
            "name": "Supervisor Authentication Required",
            "description": "PA1 requires supervisor role or higher",
            "triggers": {
              "onScreenLoad": true
            },
            "condition": {
              "id": "supervisor_role_check",
              "type": "user_role",
              "requiredRole": "SUPERVISEUR",
              "allowHigherRoles": true
            },
            "actionsOnTrue": [
              {
                "id": "enable_pa1_form",
                "type": "set_field_value",
                "fieldName": "supervisor_authenticated",
                "value": true
              }
            ],
            "actionsOnFalse": [
              {
                "id": "block_pa1_access",
                "type": "show_message",
                "message": "Authentification superviseur requise pour accéder à PA1.",
                "messageType": "error",
                "requireAcknowledgment": true
              }
            ],
            "priority": 500,
            "enabled": true,
            "evaluation": {
              "continueOnError": false
            }
          },
          {
            "id": "pa1_decision_logic",
            "name": "PA1 Decision Logic",
            "description": "Handle PA1 branching logic based on supervisor decisions",
            "triggers": {
              "onUserAction": ["validate_decision"]
            },
            "condition": {
              "id": "complex_pa1_logic",
              "operator": "and",
              "conditions": [
                {
                  "id": "conformity_check",
                  "type": "field_value",
                  "fieldName": "CONFORME",
                  "operator": "not_equals",
                  "expectedValue": "REBUT"
                }
              ]
            },
            "actionsOnTrue": [
              {
                "id": "determine_next_step",
                "type": "custom_function",
                "functionName": "determinePA1NextStep",
                "parameters": {
                  "conformeValue": "{{CONFORME}}",
                  "besoinFinitionValue": "{{BESOIN_DE_FINITION}}"
                }
              }
            ],
            "actionsOnFalse": [
              {
                "id": "handle_rebut",
                "type": "navigate_to_step",
                "targetStepId": "999"
              },
              {
                "id": "rebut_urrats_notification",
                "type": "trigger_notification",
                "notificationType": "URRATS",
                "message": "PA1 ProcessDalle - Pièce mise au REBUT par superviseur",
                "urgency": "critical"
              }
            ],
            "priority": 300,
            "enabled": true,
            "evaluation": {
              "continueOnError": false
            }
          }
        ],
        "urratsRules": [
          {
            "id": "pa1_rebut_urrats",
            "name": "PA1 REBUT URRATS Notification",
            "category": "urrats",
            "triggers": {
              "onFieldChange": ["CONFORME"]
            },
            "condition": {
              "id": "rebut_selected",
              "type": "field_value",
              "fieldName": "CONFORME",
              "operator": "equals",
              "expectedValue": "REBUT"
            },
            "actionsOnTrue": [
              {
                "id": "immediate_urrats",
                "type": "trigger_notification",
                "notificationType": "URRATS",
                "message": "REBUT PA1 ProcessDalle - Validation superviseur négative",
                "urgency": "critical"
              }
            ],
            "priority": 400,
            "enabled": true,
            "evaluation": {
              "continueOnError": true
            },
            "urgency": "CRITICAL",
            "escalationLevel": 3,
            "notification": {
              "immediate": true,
              "channels": ["email", "system", "dashboard"],
              "recipients": {
                "supervisors": true,
                "qualityTeam": true
              }
            }
          }
        ],
        "globalSettings": {
          "evaluationMode": "immediate",
          "errorHandling": "stop_on_error",
          "logLevel": "info"
        },
        "context": {
          "processId": "ProcessDalle",
          "processType": "ProcessDalle",
          "stepId": "1008",
          "userRole": "SUPERVISEUR",
          "environmentType": "production"
        }
      },
      
      "navigation": {
        "stepId": "1008",
        "processId": "ProcessDalle",
        "primaryNavigation": {
          "type": "branching",
          "branching": {
            "id": "pa1_decision_branches",
            "branches": [
              {
                "id": "rebut_branch",
                "name": "REBUT",
                "description": "Pièce non conforme - mise au rebut",
                "condition": {
                  "id": "rebut_decision",
                  "type": "field_value",
                  "fieldName": "CONFORME",
                  "operator": "equals",
                  "expectedValue": "REBUT"
                },
                "target": {
                  "id": "go_to_rebut",
                  "type": "step",
                  "stepId": "999",
                  "mode": "push"
                },
                "priority": 100,
                "visual": {
                  "icon": "warning-outline",
                  "color": "#DC2626",
                  "buttonText": "REBUT"
                }
              },
              {
                "id": "finition_required_branch",
                "name": "Finition Requise",
                "description": "Conforme avec besoin de finition",
                "condition": {
                  "id": "finition_needed",
                  "operator": "and",
                  "conditions": [
                    {
                      "id": "conforme_ok",
                      "type": "field_value",
                      "fieldName": "CONFORME",
                      "operator": "equals",
                      "expectedValue": "OUI"
                    },
                    {
                      "id": "finition_yes",
                      "type": "field_value",
                      "fieldName": "BESOIN_DE_FINITION",
                      "operator": "equals",
                      "expectedValue": "OUI"
                    }
                  ]
                },
                "target": {
                  "id": "go_to_pc8",
                  "type": "step",
                  "stepId": "10091",
                  "mode": "push"
                },
                "priority": 200,
                "visual": {
                  "icon": "construct-outline",
                  "color": "#F59E0B",
                  "buttonText": "Finition"
                }
              },
              {
                "id": "direct_insertion_branch",
                "name": "Insertion Directe",
                "description": "Conforme sans finition - insertion directe",
                "condition": {
                  "id": "direct_insertion",
                  "operator": "and",
                  "conditions": [
                    {
                      "id": "conforme_ok",
                      "type": "field_value",
                      "fieldName": "CONFORME",
                      "operator": "equals",
                      "expectedValue": "OUI"
                    },
                    {
                      "id": "finition_no",
                      "type": "field_value",
                      "fieldName": "BESOIN_DE_FINITION",
                      "operator": "equals",
                      "expectedValue": "NON"
                    }
                  ]
                },
                "target": {
                  "id": "go_to_pc11",
                  "type": "step",
                  "stepId": "10111",
                  "mode": "push"
                },
                "priority": 300,
                "visual": {
                  "icon": "checkmark-circle-outline",
                  "color": "#10B981",
                  "buttonText": "Insertion"
                }
              }
            ],
            "behavior": {
              "evaluationOrder": "priority",
              "allowMultipleMatches": false,
              "requireExplicitChoice": true
            },
            "selectionUI": {
              "displayType": "cards",
              "layout": "horizontal",
              "showDescription": true,
              "showIcons": true
            }
          }
        },
        "guards": [
          {
            "id": "supervisor_auth_guard",
            "condition": {
              "id": "not_supervisor",
              "type": "user_role",
              "requiredRole": "OPERATEUR"
            },
            "onBlock": {
              "showMessage": "Authentification superviseur requise pour PA1.",
              "messageType": "error",
              "requireConfirmation": true
            },
            "priority": 100
          }
        ],
        "history": {
          "trackHistory": true,
          "backButton": {
            "enabled": true,
            "confirmBeforeBack": true,
            "confirmationMessage": "Êtes-vous sûr de vouloir annuler cette validation superviseur ?"
          }
        },
        "settings": {
          "defaultTransition": {
            "animation": "slide",
            "duration": 300
          },
          "confirmBeforeNavigate": true,
          "confirmationMessage": "Confirmer votre décision ?",
          "onNavigationError": "retry"
        },
        "context": {
          "userRole": "SUPERVISEUR",
          "processType": "ProcessDalle"
        }
      },
      
