      "validation": {
        "stepId": "1008",
        "processId": "ProcessDalle",
        "processType": "ProcessDalle",
        "fields": [
          {
            "fieldName": "supervisor_authentication",
            "displayName": "Authentification superviseur",
            "rules": [
              {
                "id": "supervisor_auth_check",
                "type": "external",
                "severity": "error",
                "timing": "onSubmit",
                "message": "Authentification superviseur requise.",
                "enabled": true,
                "required": true,
                "settings": {
                  "apiEndpoint": "/api/auth/validate-supervisor",
                  "method": "POST",
                  "payload": {
                    "stepId": "1008",
                    "requiredRole": "SUPERVISEUR"
                  },
                  "successCondition": {
                    "field": "authenticated",
                    "value": true,
                    "operator": "equals"
                  },
                  "timeout": 10000,
                  "retries": 2,
                  "cacheResult": false,
                  "cacheDuration": 0
                }
              }
            ],
            "settings": {
              "highlightErrors": true,
              "showErrorIcon": true
            },
            "errorDisplay": {
              "position": "below"
            }
          },
          {
            "fieldName": "CONFORME",
            "displayName": "Conformité de la pièce",
            "rules": [
              {
                "id": "conformity_decision_required",
                "type": "required",
                "severity": "error",
                "timing": "onSubmit",
                "message": "Vous devez indiquer si la pièce est conforme (OUI ou REBUT).",
                "enabled": true,
                "required": true,
                "settings": {
                  "allowEmpty": false,
                  "allowWhitespace": false,
                  "customEmptyValues": [null, "", "N/A"]
                }
              }
            ],
            "settings": {
              "highlightErrors": true,
              "showErrorIcon": true,
              "showSuccessIcon": true
            },
            "errorDisplay": {
              "position": "below",
              "showFieldName": true
            }
          },
          {
            "fieldName": "BESOIN_DE_FINITION",
            "displayName": "Besoin de finition",
            "rules": [
              {
                "id": "finition_decision_conditional",
                "type": "cross_field",
                "severity": "error",
                "timing": "onSubmit",
                "message": "Vous devez indiquer si un besoin de finition est nécessaire.",
                "enabled": true,
                "required": false,
                "condition": {
                  "field": "CONFORME",
                  "value": "OUI",
                  "operator": "equals"
                },
                "settings": {
                  "targetField": "CONFORME",
                  "comparison": "equals",
                  "dataType": "string"
                }
              }
            ],
            "settings": {
              "highlightErrors": true,
              "showErrorIcon": true
            },
            "errorDisplay": {
              "position": "below"
            }
          }
        ],
        "rebutValidation": [
          {
            "id": "pa1_rebut_validation",
            "type": "business_logic",
            "severity": "error",
            "timing": "onSubmit",
            "message": "Validation REBUT superviseur",
            "enabled": true,
            "required": true,
            "condition": {
              "field": "CONFORME",
              "value": "REBUT",
              "operator": "equals"
