  "description": "Duhalde Industries concrete traceability - RoR Industrial Suite client implementation",
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx}",
    "build": "tsc",
    "dev:duhalde": "npm run start",
